{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0 --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:db": "node tests/database.mjs",
    "test:orders": "node --import tsx --test --test-isolation=none tests/admin-orders.mjs tests/order-queue-ui.mjs tests/order-audio.mjs",
    "test:connect": "node --test --test-isolation=none tests/connect-session.mjs",
    "test:master-controls": "node --test --test-isolation=none tests/admin-access.mjs tests/connect-contract.mjs tests/connect-session.mjs tests/owner-messages.mjs tests/owner-messages-database.mjs tests/plan-usage.mjs tests/remote-controls.mjs tests/order-reporting.mjs tests/addons.mjs tests/order-reporting-database.mjs",
    "test:scheduling": "node --import tsx --test --test-isolation=none tests/scheduling.mjs tests/scheduling-database.mjs",
    "whatsapp:connection": "pwsh -NoProfile -File backend/whatsapp/connection.ps1",
    "test:whatsapp-connection": "node --test --test-isolation=none tests/whatsapp-connection.mjs tests/whatsapp-connection-client.mjs tests/store-connection.mjs tests/whatsapp.mjs",
    "test:marketing": "node tests/marketing-database.mjs && node --test --test-isolation=none tests/marketing-worker.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
